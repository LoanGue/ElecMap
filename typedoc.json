{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "docs/api",
  "name": "ElecMap",
  "plugin": ["./docs/site/typedoc-plugin.mjs"],
  "readme": "docs/en/home.md",
  "excludePrivate": true,
  "excludeInternal": true,
  "categorizeByGroup": false,
  "categoryOrder": [
    "Guides",
    "Reference",
    "Circuit",
    "DC & AC analyses",
    "Transfer functions",
    "Literal transfer functions",
    "Equivalents",
    "Time domain",
    "Schematics",
    "Circuit JSON",
    "SPICE, units & LaTeX",
    "Math",
    "Internals",
    "*"
  ],
  "groupOrder": [
    "Creating a circuit",
    "Circuit description",
    "Voltages, currents & power",
    "Transfer functions",
    "Impedances & equivalents",
    "Time domain",
    "Schematic",
    "*"
  ],
  "navigation": {
    "includeCategories": true,
    "includeGroups": false,
    "includeFolders": false
  },
  "sort": ["kind", "instance-first", "alphabetical-ignoring-documents"],
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "treatWarningsAsErrors": true,
  "customCss": "docs/site/theme.css",
  "customJs": "docs/site/theme.js",
  "headings": {
    "readme": false,
    "document": false
  }
}
