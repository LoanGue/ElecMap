{
  "name": "elecmap",
  "version": "0.0.0",
  "description": "TypeScript engine for electrical circuit analysis: transfer functions, node voltages, branch currents, equivalent impedances and SVG schematics from a SPICE netlist or JSON.",
  "license": "MIT",
  "author": "Loan Gue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoanGue/ElecMap.git"
  },
  "homepage": "https://loangue.github.io/ElecMap/",
  "bugs": "https://github.com/LoanGue/ElecMap/issues",
  "keywords": [
    "circuit",
    "electronics",
    "spice",
    "netlist",
    "mna",
    "transfer-function",
    "bode",
    "impedance",
    "schematic",
    "svg"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "docs": "tsx docs/site/build.ts",
    "playground": "tsx docs/playground/build.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run check",
    "examples": "node scripts/run-examples.mjs",
    "test:pack": "npm run build && node scripts/smoke-pack.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
